generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlotType {
  RECTANGLE
  SQUARE
  TRIANGLE
  TRAPEZIUM
  CORNER
  CURVED
  IRREGULAR
  CUSTOM
}

model CadProject {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  latitude    Float?
  longitude   Float?
  mapZoom     Int?
  address     String?
  city        String?
  state       String?
  country     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  labelFontSize   Float?
  labelFontFamily String?
  labelFontColor  String?
  conversions CadConversion[]
  plots       ProjectPlot[]
  amenityPlacements AmenityPlacement[]
  plotStatuses PlotStatus[]
  boundaries  ProjectBoundary[]
  appearanceSettings ProjectAppearanceSettings?
}

model ProjectBoundary {
  id          Int         @id @default(autoincrement())
  projectId   Int
  project     CadProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String      @default("Boundary")
  area        Float?
  pointCount  Int?
  latMin      Float?
  latMax      Float?
  lngMin      Float?
  lngMax      Float?
  geoJson     String      // Stores the exact polygon coordinates
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CadConversion {
  id               Int         @id @default(autoincrement())
  projectId        Int?
  project          CadProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalFileName String
  originalFilePath String
  svgFilePath      String?
  cadVersion       String?
  status           String      @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED
  conversionTime   Int?
  fileSize         Int?
  entityCount      Int?
  layerCount       Int?
  blockCount       Int?
  errorMessage     String?
  mapLatitude      Float?
  mapLongitude     Float?
  mapRotation      Float?      @default(0)
  mapScale         Float?      @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  amenityPlacements AmenityPlacement[]
  plots            ProjectPlot[]
  layoutLineColor  String?
  shapeAppearances CadShapeAppearance[]
}

model Amenity {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  category    String
  iconPath        String
  defaultWidth    Float?
  defaultHeight   Float?
  defaultRotation Float?
  createdAt       DateTime @default(now())
  updatedAt   DateTime @updatedAt
  placements  AmenityPlacement[]
}

model PlotStatus {
  id           Int           @id @default(autoincrement())
  projectId    Int
  project      CadProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  fillColor    String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  plots        ProjectPlot[]

  @@unique([projectId, name])
}

model ProjectPlot {
  id          Int         @id @default(autoincrement())
  projectId   Int
  project     CadProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plotNumber  String
  plotType    PlotType    @default(RECTANGLE)
  dimensions  Json?
  areaSqFt    Float?
  areaSqYard  Float?
  areaSqMeter Float?
  statusId    Int?
  status      PlotStatus? @relation(fields: [statusId], references: [id])
  remarks     String?
  cadRegionId   String? // To link with specific regions in the CAD editor SVG
  conversionId  Int?
  conversion    CadConversion? @relation(fields: [conversionId], references: [id], onDelete: SetNull)
  cadObjectType String?
  x             Float?
  y             Float?
  rotation      Float?
  scale         Float?
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([projectId, plotNumber])
}

model AmenityPlacement {
  id           Int           @id @default(autoincrement())
  amenityId    Int
  amenity      Amenity       @relation(fields: [amenityId], references: [id])
  projectId    Int
  project      CadProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversionId Int
  conversion   CadConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  x            Float
  y            Float
  width        Float
  height       Float
  rotation     Float         @default(0)
  layerOrder   Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model CadShapeAppearance {
  id           Int           @id @default(autoincrement())
  conversionId Int
  conversion   CadConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  cadRegionId  String
  fillColor    String?
  strokeColor  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([conversionId, cadRegionId])
}

model ProjectAppearanceSettings {
  id              Int        @id @default(autoincrement())
  projectId       Int        @unique
  project         CadProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dimensionColor  String?
  plotColor       String?
  plotLabelColor  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}
